{
  "name": "vscode-resource-hover-preview-companion",
  "displayName": "Resource Hover Preview",
  "version": "0.5.39",
  "publisher": "wangdong",
  "repository": {
    "type": "git",
    "url": "https://github.com/wangdong233/vscode-resource-hover-preview.git"
  },
  "description": "原生资源管理器悬停浮动预览（伴随扩展：触发 patch + 跑 EH server）",
  "main": "./dist/extension.js",
  "engines": {
    "vscode": "^1.84.0"
  },
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "commands": [
      {
        "command": "resourceHoverPreview.patch",
        "title": "Resource Hover Preview: Patch Workbench"
      },
      {
        "command": "resourceHoverPreview.revert",
        "title": "Resource Hover Preview: Revert"
      },
      {
        "command": "resourceHoverPreview.status",
        "title": "Resource Hover Preview: Status"
      }
    ],
    "configuration": {
      "title": "Resource Hover Preview",
      "properties": {
        "resource-hover-preview.enabled": {
          "type": "boolean",
          "default": true,
          "description": "启用资源管理器悬停浮动预览。设为 false 关闭（需 Cmd+Q 完全重启生效，mp-config.js 走磁盘缓存）。"
        },
        "resource-hover-preview.prewarmAudio": {
          "type": "boolean",
          "default": true,
          "description": "启动后后台预提取 AAC 家族音轨到本地缓存(消除视频预览首次 ~1.4s;nice 低优先级串行,80 文件/8 分钟预算)"
        },
        "resource-hover-preview.blurMode": {
          "type": "string",
          "enum": [
            "reduced",
            "off",
            "full"
          ],
          "default": "reduced",
          "description": "玻璃效果模式(0.5.39 起播闪白第二轮):reduced=默认(子控件无毛玻璃+视频起播 480ms 内主玻璃暂关);off=主玻璃永久关(自测闪白是否来自毛玻璃合成);full=毛玻璃全时(禁起播窗)。需 Cmd+Q 重启生效。"
        }
      }
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "package": "vsce package --no-dependencies"
  },
  "devDependencies": {
    "@types/vscode": "^1.84.0",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0",
    "@vscode/vsce": "^3.2.0"
  }
}
